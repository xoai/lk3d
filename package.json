{
  "name": "lk3d",
  "version": "0.1.0",
  "description": "A small engine for explorable, accessible 3D diagrams built from data: take apart, cut open, label, move parts by hand",
  "keywords": [
    "3d",
    "webgl",
    "diagram",
    "education",
    "explainer",
    "accessibility",
    "gltf",
    "visualization",
    "science"
  ],
  "license": "MIT",
  "author": "xoai",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "bin": {
    "lk3d": "./bin/lk3d.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./validate": {
      "types": "./validate.d.ts",
      "default": "./src/validate.js"
    },
    "./lint": {
      "types": "./lint.d.ts",
      "default": "./src/lint.js"
    },
    "./export": {
      "types": "./export.d.ts",
      "default": "./src/export.js"
    },
    "./schema.json": "./schema/scene.schema.json",
    "./bundle": "./dist/lk3d.min.js",
    "./package.json": "./package.json",
    "./bundle.mjs": "./dist/lk3d.mjs",
    "./bundle-export": "./dist/lk3d-export.min.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "schema/",
    "index.d.ts",
    "scene.d.ts",
    "skill/",
    "lint.d.ts",
    "export.d.ts",
    "validate.d.ts",
    "docs/*.md",
    "docs/*.png",
    "docs/shapes/*.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!skill/lk3d/evals"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/export.js",
    "./src/export-script.js",
    "./dist/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.cjs",
    "size": "node build.mjs --size",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node scripts/types.mjs --scenes",
    "types": "node scripts/types.mjs",
    "test:visual": "node build.mjs && playwright test -c test/visual/playwright.config.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "examples": "node build.mjs && node test/visual/serve.mjs",
    "docs": "node docs/scene-format.mjs && node docs/shapes/render.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run typecheck && npm run size",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.25.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
