{
  // the engine's sources, type-checked as JavaScript (npm run typecheck): JSDoc types, the scene's types from
  // scene.d.ts, a mounted figure's shared state from src/figure/context.d.ts. Strict, null checks too (a value
  // set later is typed where it is declared: /** @type {X | null} */), but for implicit any
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
