{
  // the engine's sources, type-checked as JavaScript (npm run typecheck): JSDoc types, the scene's types from
  // scene.d.ts, a mounted figure's shared state from src/figure/context.d.ts. Strict but for implicit any and
  // null checks (a later step: many idiomatic `let x = null` to annotate first)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
